# Au moins une clé LLM est requise si un site n'expose pas de JSON-LD exploitable.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

# Alertes LeBonCoin par email (optionnel — contourne l'anti-bot)
LBC_EMAIL_HOST=imap.gmail.com
LBC_EMAIL_USER=
LBC_EMAIL_PASS=
LBC_EMAIL_SENDER=

# Notification par email (prévu dans le dashboard, pas encore implémenté côté scraper)
NOTIFY_EMAIL_USER=
NOTIFY_EMAIL_PASS=
NOTIFY_EMAIL_TO=
